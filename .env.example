# Copy to .env and fill in values. Never commit .env.

# --- LLM (Cerebras) ---
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=
# Optional second account key (separate daily quota). Used when primary hits limit or when forced.
CEREBRAS_SECONDARY_API_KEY=
# Which key to prefer: primary | secondary | auto (failover on quota errors)
CEREBRAS_KEY_PROFILE=auto
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_REASONING_EFFORT=low
ENABLE_TPM_PREFLIGHT=1
# Cerebras prefix caching (default on). Static notebook baseline keeps system prefix stable.
CEREBRAS_PROMPT_CACHE=1
CEREBRAS_STATIC_NOTEBOOK_CACHE=1
# CHAT_SESSION_PER_MODE=1
# Baseline compact caps (reduce repeated prompt size; live state via deltas)
# BASELINE_MAX_CELL_INPUT_CHARS=1500
# BASELINE_MAX_CELL_OUTPUT_CHARS=350
# BASELINE_MAX_TOTAL_CHARS=10000
# MAX_TOOL_RESULT_CHARS=2200

# ReAct / agentic server capability (user must also enable dashboard toggle + Agentic mode)
LLM_AGENTIC_ENABLED=0
# Cerebras agentic: parse <agent_tool_batch> from chat (default on). Set 0 for native API tools.
# AGENTIC_TEXT_TOOLS=1
# Host-managed workflow planner for multi-step tasks (Titanic pipeline, EDA, CNN, etc.)
# AGENTIC_PLANNER=1
# Host semantic index for notebook symbols (imports, DataFrames, models, etc.)
# AGENTIC_SEMANTIC_INDEX=1
# Host dependency graph (symbol/cell relationships, impact analysis)
# AGENTIC_DEPENDENCY_GRAPH=1
# Host runtime state (execution outputs, shapes, metrics)
# AGENTIC_RUNTIME_STATE=1
LLM_REACT_MAX_ROUNDS=6
LLM_PARALLEL_TOOL_CALLS=0
# AIML API (disabled until project finalized)
# AIML_API_KEY=
# AIML_MODEL=x-ai/grok-4-1-fast-reasoning
# AIML_API_BASE_URL=https://api.aimlapi.com/v1

# Kaggle API (from Account → Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Context: intent for TPM savings; full for large-context models
CONTEXT_PACK_MODE=intent
