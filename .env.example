# Copy to .env and fill in values. Never commit .env.

# Cerebras — active provider
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# AIML API (disabled until project finalized)
# AIML_API_KEY=
# AIML_MODEL=x-ai/grok-4-1-fast-reasoning
# AIML_API_BASE_URL=https://api.aimlapi.com/v1

# Kaggle API (stable kernel id for chat — from Account → Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Context: intent for Cerebras TPM limits; full for large-context LLMs (e.g. AIML/Grok)
CONTEXT_PACK_MODE=intent
