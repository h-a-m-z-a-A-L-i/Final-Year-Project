      "notebook_key": "kaggle:kernel:113620421",
      "mode": "ask",
      "target_cell": 17,
      "ground_truth_terms": ["date_added", "drop"],
      "coverage_topics": ["input", "output", "depend", "issue", "purpose", "why"],
      "prompt": "Explain cell 17.\n\nInclude:\n1. Inputs\n2. Outputs\n3. Dependencies\n4. Why the cell exists\n5. Potential issues\n\nDo not generate replacement code."
