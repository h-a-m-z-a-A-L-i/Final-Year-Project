      "notebook_key": "kaggle:kernel:112732919",
      "mode": "ask",
      "target_cell": 31,
      "ground_truth_terms": ["df", "not defined", "NameError"],
      "coverage_topics": ["root cause", "fix", "impact", "minimal"],
      "prompt": "Explain the root cause of the error in cell 31.\n\nDo not provide a complete replacement script.\n\nProvide:\n- Root cause\n- A minimal fix suggestion\n- Expected impact"
