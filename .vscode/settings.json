{
    "python-envs.defaultEnvManager":  "ms-python.python:system",
    "latex-workshop.latex.rootFile":  "latex format/Final-Year-Project-Format-main/_fyp-ch1-preview.tex",
    "latex-workshop.latex.outDir":  "latex format/Final-Year-Project-Format-main/build",
    "latex-workshop.latex.recipes":  [
                                         {
                                             "tools":  [
                                                           "pdflatex",
                                                           "pdflatex"
                                                       ],
                                             "name":  "pdflatex x2 (front matter only)"
                                         },
                                         {
                                             "name":  "latexmk (biber)",
                                             "tools":  [
                                                           "latexmk_biber"
                                                       ]
                                         },
                                         {
                                             "name":  "pdflatex -\u003e biber -\u003e pdflatex*2",
                                             "tools":  [
                                                           "pdflatex",
                                                           "biber",
                                                           "pdflatex",
                                                           "pdflatex"
                                                       ]
                                         }
                                     ],
    "latex-workshop.latex.tools":  [
                                       {
                                           "name":  "latexmk_biber",
                                           "command":  "latexmk",
                                           "args":  [
                                                        "-synctex=1",
                                                        "-interaction=nonstopmode",
                                                        "-file-line-error",
                                                        "-pdf",
                                                        "-bibtex-",
                                                        "-outdir=%OUTDIR%",
                                                        "%DOC%"
                                                    ],
                                           "env":  {

                                                   }
                                       },
                                       {
                                           "name":  "pdflatex",
                                           "command":  "pdflatex",
                                           "args":  [
                                                        "-synctex=1",
                                                        "-interaction=nonstopmode",
                                                        "-file-line-error",
                                                        "-output-directory=%OUTDIR%",
                                                        "%DOC%"
                                                    ]
                                       },
                                       {
                                           "name":  "biber",
                                           "command":  "biber",
                                           "args":  [
                                                        "%OUTDIR%/%DOCFILE%"
                                                    ]
                                       }
                                   ],
    "latex-workshop.latex.rootFile.useSubFile":  true,
    "latex-workshop.latex.autoBuild.run":  "onSave"
}
